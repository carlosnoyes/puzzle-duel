{
  "id": "./",
  "name": "Puzzle Duel",
  "short_name": "Puzzle Duel",
  "description": "Race a friend through head-to-head puzzles. Same puzzle, same time — fastest brain wins.",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#08081a",
  "theme_color": "#08081a",
  "categories": ["games", "puzzle", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Quick Match", "short_name": "Quick Match", "description": "Ranked match against a random player", "url": "./?action=quick", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Daily Challenge", "short_name": "Daily", "description": "Today's 3 puzzles", "url": "./?action=daily", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Play vs Bot", "short_name": "Vs Bot", "url": "./?action=bot", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
